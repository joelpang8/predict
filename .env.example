# Copy to .env (never commit .env).

# Kalshi environment: "prod" or "demo".
KALSHI_ENV=prod
# Optional override of the REST base URL (otherwise chosen from KALSHI_ENV).
# KALSHI_BASE_URL=https://external-api.kalshi.com/trade-api/v2

# Client-side request ceiling. Kalshi documents token budgets for
# *authenticated* requests only; unauthenticated limits are undocumented and
# 429s were seen even at 2 req/s. Keep this low.
KALSHI_MAX_RPS=1

# Kalshi series tickers to scan per sport, comma-separated. Leave empty to
# auto-discover (see `python -m edgefinder series --search NFL`).
KALSHI_SERIES_NFL=KXNFLGAME
KALSHI_SERIES_NBA=
KALSHI_SERIES_MLB=

# The Odds API (free tier: 500 credits/month). Each `edges` run costs
# 1 credit per sport when ODDS_BOOKMAKERS lists 10 books or fewer.
ODDS_API_KEY=
# ODDS_BOOKMAKERS=pinnacle,betfair_ex_eu,lowvig,betonlineag,draftkings,fanduel,betmgm,betrivers,bovada,espnbet
# BOOK_WEIGHTS=pinnacle:3,betfair_ex_eu:2,circa:3,lowvig:1.5,betonlineag:1.5
ODDS_MIN_REMAINING=20
MIN_BOOKS=3

# Fees: 0.01 for regular (non-direct) members, 0.0001 for direct members.
FEE_PRECISION=0.01

# Chance an NFL game ends tied (Kalshi pays $0.50 per side on a tie).
# nflverse 2000-2026: 16 ties in 7,110 games.
NFL_TIE_PROB=0.0023

# Never compute an edge from data older than this, or from Kalshi and odds
# pulls further apart than MAX_SKEW_S.
MAX_DATA_AGE_S=300
MAX_SKEW_S=120

# Sizing: fractional Kelly with a hard cap per bet (fraction of bankroll).
BANKROLL=1000
KELLY_MULTIPLIER=0.25
MAX_BET_PCT=0.02

# Storage and refresh
DB_PATH=data/edgefinder.sqlite
REFRESH_COOLDOWN_S=20
# Odds pulls stop for the day (US/Eastern) at this many credits. 15/day is about 465/month.
ODDS_DAILY_CREDIT_BUDGET=15

# Background poller (python -m edgefinder poll)
POLL_INTERVAL_S=300
POLL_INTERVAL_NEAR_KICKOFF_S=120
NEAR_KICKOFF_H=3
POLLER_ODDS_INTERVAL_S=10800
# Credits per day the poller must leave for manual Refresh.
POLLER_MANUAL_RESERVE=5

# Trend signals (context only, never picks)
SIGNAL_LOOKBACK_H=72
# Recent trades are one Kalshi call per market, so only for the top N rows by net edge.
TRADES_TOP_N=6
LARGE_TRADE_USD=2500
# "Check for news" when a side we rate underpriced fell this many points in 1h or 6h.
NEWS_MOVE_PTS=5
CONFIRM_MOVE_PTS=3
# Flag volume only above this multiple of the market's normal (sports volume is bursty).
TREND_FLAG_X=5

# Top Picks guardrails (all must pass) and ranking weights. The dashboard's
# Settings tab can override these; overrides are stored in the local DB.
MIN_NET_EDGE_PTS=3
MIN_LIQUIDITY_USD=500
MAX_SPREAD_CENTS=3
NEAR_START_MIN=30
NEAR_START_MAX_AGE_S=90
MAX_DAILY_EXPOSURE_PCT=0.10
MAX_SPORT_EXPOSURE_PCT=0.06
TOP_N=10
W_EDGE=0.40
W_MODEL=0.20
W_LIQUIDITY=0.15
W_MOVEMENT=0.10
W_FRESHNESS=0.15
