# Copy to .env (never commit .env).

# Kalshi environment: "prod" or "demo".
KALSHI_ENV=prod
# Optional override of the REST base URL (otherwise chosen from KALSHI_ENV).
# KALSHI_BASE_URL=https://external-api.kalshi.com/trade-api/v2

# Client-side request ceiling. Kalshi's official rate-limit page could not be
# read when this was written, so this is a conservative self-imposed limit,
# not a documented number. Keep it low until verified.
KALSHI_MAX_RPS=5

# Kalshi series tickers to scan per sport, comma-separated. Leave empty to
# auto-discover (see `python -m edgefinder series --search NFL`).
KALSHI_SERIES_NFL=
KALSHI_SERIES_NBA=
KALSHI_SERIES_MLB=

# The Odds API (phase 2).
ODDS_API_KEY=
