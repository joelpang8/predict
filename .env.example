# Copy to .env (never commit .env).

# Kalshi environment: "prod" or "demo".
KALSHI_ENV=prod
# Optional override of the REST base URL (otherwise chosen from KALSHI_ENV).
# KALSHI_BASE_URL=https://external-api.kalshi.com/trade-api/v2

# Client-side request ceiling. Kalshi documents token budgets for
# *authenticated* requests only; unauthenticated limits are undocumented and
# we were rate-limited after ~6 quick calls. Keep this low.
KALSHI_MAX_RPS=2

# Kalshi series tickers to scan per sport, comma-separated. Leave empty to
# auto-discover (see `python -m edgefinder series --search NFL`).
KALSHI_SERIES_NFL=KXNFLGAME
KALSHI_SERIES_NBA=
KALSHI_SERIES_MLB=

# The Odds API (free tier: 500 credits/month). Each `edges` run costs
# 1 credit per sport when ODDS_BOOKMAKERS lists 10 books or fewer.
ODDS_API_KEY=
# ODDS_BOOKMAKERS=pinnacle,betfair_ex_eu,lowvig,betonlineag,draftkings,fanduel,betmgm,betrivers,bovada,espnbet
# BOOK_WEIGHTS=pinnacle:3,betfair_ex_eu:2,circa:3,lowvig:1.5,betonlineag:1.5
ODDS_MIN_REMAINING=20
MIN_BOOKS=3

# Fees: 0.01 for regular (non-direct) members, 0.0001 for direct members.
FEE_PRECISION=0.01

# Assumption: chance an NFL game ends tied (Kalshi pays $0.50 per side on a tie).
NFL_TIE_PROB=0.003

# Never compute an edge from data older than this, or from Kalshi and odds
# pulls further apart than MAX_SKEW_S.
MAX_DATA_AGE_S=300
MAX_SKEW_S=120

# Sizing: fractional Kelly with a hard cap per bet (fraction of bankroll).
BANKROLL=1000
KELLY_MULTIPLIER=0.25
MAX_BET_PCT=0.02
